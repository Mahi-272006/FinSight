# LLM Providers (free tiers only -- FinSight never falls back to a paid API)
GROQ_API_KEY=
GEMINI_API_KEY=
# Failover chain, tried in order. Providers without keys are skipped (logged);
# if none remain, the LLM layer errors with setup instructions.
LLM_PROVIDER_CHAIN=groq,gemini
# Primary provider (Groq) model / fallback provider (Gemini) model.
# Empty FALLBACK_LLM_MODEL uses the live-verified default (gemini-3.5-flash).
LLM_MODEL=openai/gpt-oss-20b
FALLBACK_LLM_MODEL=
# All optional; values below are the code defaults.
#LLM_TIMEOUT_SECONDS=30.0
#LLM_MAX_TOKENS=2048
#LLM_TEMPERATURE=0.1
#PROMPT_CONTEXT_CHARS=16000

# Local LLM (add "ollama" to LLM_PROVIDER_CHAIN to use; requires OLLAMA_MODEL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# SEC
SEC_USER_AGENT=FinSightAI contact@example.com

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/finsight

# ChromaDB (relative paths are resolved against backend/, never the CWD)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
