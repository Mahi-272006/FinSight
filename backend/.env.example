# LLM Providers (free tiers only -- FinSight never falls back to a paid API)
GROQ_API_KEY=
GEMINI_API_KEY=
# Failover chain, tried in order. Providers without keys are skipped (logged);
# if none remain, the LLM layer errors with setup instructions.
LLM_PROVIDER_CHAIN=groq,gemini
# Primary provider (Groq) model / fallback provider (Gemini) model.
# Empty FALLBACK_LLM_MODEL uses the live-verified default (gemini-3.5-flash).
LLM_MODEL=openai/gpt-oss-20b
FALLBACK_LLM_MODEL=
# All optional; values below are the code defaults.
#LLM_TIMEOUT_SECONDS=30.0
#LLM_MAX_TOKENS=2048
#LLM_TEMPERATURE=0.1
#PROMPT_CONTEXT_CHARS=16000
# M6 hardening: one wait on a 429 (provider's Retry-After hint wins, capped
# at 60s), one retry, then fail over. Default sized to Groq's free tier.
#LLM_RATE_LIMIT_WAIT_SECONDS=12.0
# Research agent hard caps: iterations = LLM calls in the research loop
# (force-stop message at the cap), revises = validation-driven redo rounds.
#AGENT_MAX_ITERATIONS=6
#AGENT_MAX_REVISES=1

# Local LLM (add "ollama" to LLM_PROVIDER_CHAIN to use; requires OLLAMA_MODEL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# SEC
SEC_USER_AGENT=FinSightAI contact@example.com

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/finsight

# ChromaDB (relative paths are resolved against backend/, never the CWD)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# API (M9): browser origins allowed by CORS, comma-separated (defaults shown).
# localhost and 127.0.0.1 are DISTINCT origins to a browser even though both
# are this machine -- keep both while the Vite dev server is used either way.
#CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
